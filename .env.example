# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API Keys). Either the new or the legacy key formats work.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live reminders stay disabled until provider configuration is ready.
REMINDERS_ENABLED=false
CRON_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Comma-separated Supabase Auth user IDs authorised to export all clients.
# Leave empty to disable staff exports. Never add client accounts.
EXPORT_STAFF_USER_IDS=
